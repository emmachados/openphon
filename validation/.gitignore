.venv/
refs/
__pycache__/
real_sources.local.json

# Audio never enters the repository. The two exceptions are the public
# sub-tier's manifest and provenance, which describe redistributable
# corpora and are what makes that tier reproducible from a clean checkout;
# the audio it refers to is re-fetched, not committed.
wavs/
!wavs/
wavs/*
!wavs/public/
wavs/public/*
!wavs/public/manifest.csv
!wavs/public/provenance.json

# Per-file, per-frame deviation samples: derived from participant audio,
# and re-derivable by rerunning the scripts that write them.
intertracker_cache/
devs_*/
transcripts/
alignment/

# Upstream corpus archives cached between runs (Common Voice ships its
# splits as tarballs, not as clip-addressable rows). Large, redistributable,
# and re-fetched from the pinned revision when absent.
.corpus_cache/

# Run outputs: regenerated by the scripts, not evidence in themselves.
sweep_report*.json
compare_report.json
public_report.json
public_run.txt

# withheld corpus, retained locally pending a consent decision
_withheld_pt/

# Per-recording analysis caches written by tracks.py: large, derived from
# audio that is itself not committed, and regenerated by rerunning it.
trackcache_*/
.tools/

# Logs from the runs that produce the committed artefacts.
*.log
pubcache/
dis_cache_public/

# The app-store survey is out of scope for the methodology paper (its
# locale bug makes it unusable as reported) and its raw pull is large.
appsurvey_raw.csv
appsurvey_screened.csv
